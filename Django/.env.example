# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
DEBUG=False
SECRET_KEY=your-secret-key-here-generate-with-python-manage-py-generatesecretkey
ALLOWED_HOSTS=railway.app,localhost,127.0.0.1

# --- Database: 'sqlite' for development, 'postgresql' for deployment ---
DB_ENGINE=postgresql
DB_NAME=muq_system
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- API ---
API_PAGE_SIZE=100
# Comma-separated origins of the pages allowed to call this API.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True

# --- JWT ---
JWT_ACCESS_TOKEN_HOURS=2
JWT_REFRESH_TOKEN_DAYS=7

# --- Sessions ---
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# --- Locale ---
LANGUAGE_CODE=ar
TIME_ZONE=Asia/Baghdad

# --- Production hardening (ignored while DEBUG=True) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
