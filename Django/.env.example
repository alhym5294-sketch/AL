# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database: 'sqlite' for development, 'postgresql' for deployment ---
DB_ENGINE=sqlite
DB_NAME=muq_system
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- API ---
API_PAGE_SIZE=100
# Comma-separated origins of the pages allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:8010
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOW_CREDENTIALS=True

# --- Sessions ---
SESSION_COOKIE_AGE=28800
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# --- Locale ---
LANGUAGE_CODE=ar
TIME_ZONE=Asia/Baghdad

# --- Production hardening (ignored while DEBUG=True) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
